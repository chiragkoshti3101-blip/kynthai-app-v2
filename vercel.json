{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "devCommand": "npm run dev",
  "installCommand": "npm install --registry=https://registry.npmjs.org/",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/reminders/schedule",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/reminders/send",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/chat/cleanup",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/appointment-reminders",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw-v3.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
