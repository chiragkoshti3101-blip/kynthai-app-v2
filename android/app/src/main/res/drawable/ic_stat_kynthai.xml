<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar notification icon.

  Android uses ONLY the alpha channel of a notification small icon and
  repaints it white, so this must be a single-colour silhouette on a
  transparent background — never the full-colour launcher icon, which would
  render as a blank white square.

  Shape: Kynthai heart outline with the ECG pulse line (matches public/favicon.svg).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Heart outline -->
    <path
        android:pathData="M24,39 C17.5,34.5 7,27.5 7,18 C7,11.5 11.5,7.5 17,7.5 C20.2,7.5 22.4,9.8 24,11.6 C25.6,9.8 27.8,7.5 31,7.5 C36.5,7.5 41,11.5 41,18 C41,27.5 30.5,34.5 24,39 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- ECG pulse line -->
    <path
        android:pathData="M12,24 L17.5,24 L19.5,18.5 L21.5,29.5 L24,15 L26.5,29.5 L28.5,18.5 L30.5,24 L36,24"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
