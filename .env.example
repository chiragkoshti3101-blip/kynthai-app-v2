# ============================================================================
# Kynthai Environment Variables — TEMPLATE
# ============================================================================
# Copy to `.env.local` (dev) or configure in Vercel Project → Settings → Env
# Variables. NEVER commit the populated file — `.env*` is gitignored.
#
# This file mirrors the ACTUAL variables referenced by the codebase
# (`grep -rhoE 'process\.env\.[A-Z0-9_]+' src`). Vars only used by helper
# scripts are listed in the last section.
# ============================================================================

# ────── Next.js / App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://kynthai.app
NODE_ENV=production
NEXT_PHASE=phase-production-build

# ────── Database (Postgres / Supabase) ───────────────────────────────────────
# Direct connection — used by Prisma migrations and long-lived queries.
# For Supabase, append `?sslmode=require` and URL-encode special chars.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
# Pooler URL for serverless runtimes (PgBouncer transaction mode).
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# RLS-checked client access (Supabase anon + service role). Server-only keys
# must NEVER be prefixed NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                      # anon key (safe to expose)
SUPABASE_PUBLISHABLE_KEY=                           # anon / publishable key
SUPABASE_SECRET_KEY=                                # service_role / secret key (server-only!)
SUPABASE_SERVICE_ROLE_KEY=                          # service_role (server-only!)
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# ────── Field-level encryption (PHI at rest) ────────────────────────────────
# 32 bytes = 64 hex chars via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Optional: transitional key used during key rotation (dual-read).
ENCRYPTION_TRANSITIONAL=
MASTER_ENCRYPTION_KEY=

# ────── Sessions / internal tokens ───────────────────────────────────────────
SESSION_SECRET=                                     # openssl rand -hex 32
SESSION_SIGNING_SECRET=                             # HMAC key for kynthai-session cookie
SESSION_MAX_AGE_SEC=604800                          # 7 days
SESSION_REFRESH_WINDOW_SEC=86400
CRON_SECRET=                                        # openssl rand -hex 32
VIDEO_TOKEN_SECRET=                                 # openssl rand -hex 32
MIGRATION_SECRET=                                   # guards data-migration endpoints
AUDIT_LOG_SYNC=                                     # "true" enables audit log sync path

# ────── Authentication (Supabase) ────────────────────────────────────────────
# HS256 JWT signing secret (Dashboard → Settings → API Keys → JWT). The raw
# UTF-8 string bytes are the HMAC key — do NOT base64-decode it first.
SUPABASE_JWT_SECRET=                                # Supabase Dashboard → Settings → API
# ES256 PUBLIC signing key (JWK) for projects whose session tokens are signed
# with Supabase's asymmetric key. Public by design — safe to embed. Omit for
# HS256-only projects. (Dashboard → Settings → API Keys → signing keys; the
# token header's kid must match the JWK's kid.)
SUPABASE_JWT_ES256_PUBLIC_JWK=                      # {"kty":"EC","crv":"P-256","x":"...","y":"...","kid":"...","alg":"ES256"}
# OAuth providers (Supabase Auth → Providers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ────── Admin / feature toggles ──────────────────────────────────────────────
ADMIN_EMAILS=admin@kynthai.app                      # comma-separated admin addresses
ALLOW_ADMIN_AS_SYSTEM=                              # "true" lets admin act as system user
ENABLE_DEMO=                                        # "true" only in dev; FORBIDDEN in prod
NEXT_PUBLIC_ENABLE_DEMO=false

# ────── CORS / Cookies / TLS ─────────────────────────────────────────────────
# Middleware reads CORS_ORIGIN (comma-separated allow-list). No wildcard in prod.
CORS_ORIGIN=https://kynthai.app,https://www.kynthai.app

# ────── Rate limiting ────────────────────────────────────────────────────────
# In-memory fallback + optional Upstash Redis for distributed limiting.
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ────── Payment (Stripe) ─────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PK=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx                      # webhook signature secret

# ────── AI (NVIDIA NIM / OpenAI-compatible) ──────────────────────────────────
CLINE_API_KEY=                                       # server-side AI gateway key
CLINE_MODEL=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
OPENAI_API_KEY=                                      # optional: live web search in /api/search-medicine

# ────── SMS (Twilio) ─────────────────────────────────────────────────────────
# NOTE: the code reads TWILIO_FROM_NUMBER (src/lib/integrations.ts). The legacy
# TWILIO_PHONE_NUMBER name is NOT used by the app — set the one below.
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567
TWILIO_MESSAGING_SERVICE_SID=MGxxx

# ────── Email (SendGrid) ─────────────────────────────────────────────────────
SENDGRID_API_KEY=

# ────── File upload scanning ─────────────────────────────────────────────────
KYNTHAI_CLAMSCAN=                                   # ClamAV endpoint URL (optional)
KYNTHAI_REQUIRE_AV=                                 # "true" rejects unscanned uploads

# ────── Turnstile (bot protection) ───────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ────── WebRTC (video calls) ─────────────────────────────────────────────────
# TURN credentials are served ONLY via the authenticated /api/turn-credentials
# endpoint — never via NEXT_PUBLIC_* (they used to be inlined into the client
# bundle where anyone could extract them). Prefer the shared-secret mode:
#   TURN_URL=              turn:turn.example.com:3478  (or NEXT_PUBLIC_TURN_URL)
#   TURN_SHARED_SECRET=    REST secret → 24h rotating credentials (preferred)
#   TURN_TTL_SECONDS=86400 # ephemeral credential validity
# Static fallback (plain coturn, no use-auth-secret):
#   TURN_USERNAME=
#   TURN_PASSWORD=
NEXT_PUBLIC_TURN_URL=                                  # deprecated alias for TURN_URL

# ────── Error tracking (Sentry) ──────────────────────────────────────────────
# Runtime errors are captured only when SENTRY_DSN is set. Config lives in
# sentry.{server,edge,client}.config.ts + src/instrumentation.ts.
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=sntrys_xxx                         # only for source-map upload at build
SENTRY_ORG=
SENTRY_PROJECT=kynthai-app

# ────── Reticle (dev-only runtime verification) ──────────────────────────────
NEXT_PUBLIC_RETICLE_TOKEN=                           # no-op in production builds

# ────── Vercel-provided ──────────────────────────────────────────────────────
VERCEL_ENV=                                         # automatically set on Vercel

# ────── Helper scripts only (not read by app code) ───────────────────────────
# scripts/backup.sh:  AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION,
#                     AWS_S3_BUCKET, BACKUP_ENABLED, BACKUP_SCHEDULE,
#                     BACKUP_RETENTION_DAYS, BACKUP_S3_BUCKET
# dev-mode.sh / docker-compose.prod.yml:  LOG_LEVEL, LOG_FORMAT, DEBUG,
#                     VERBOSE_LOGGING, LOG_RETENTION_DAYS
# ────── Web Push (PWA) notifications ─────────────────────────────────────────
# Generate a pair with: npx web-push generate-vapid-keys
# The PUBLIC key is embedded in the client bundle (NEXT_PUBLIC_ prefix); the
# PRIVATE key is server-only and must NEVER be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=                       # web-push generate-vapid-keys → publicKey
VAPID_PRIVATE_KEY=                                  # web-push generate-vapid-keys → privateKey

# ────── Native push (Android FCM + iPhone APNs) ───────────────────────────────
# Android uses Firebase Admin; keep these server-only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=                               # preserve PEM newlines as \\n
# iPhone native builds register an APNs device token. Create an Apple Push
# Notifications Auth Key (.p8) and configure the App ID capability first.
# APNS_AUTH_KEY= may contain the PEM text or its base64 encoding.
APNS_AUTH_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.kynthai.health
APNS_PRODUCTION=true
